{
    "rewrites": [
        {
            "source": "/api/polza/(.*)",
            "destination": "/api/polza?polzapath=$1"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/|.*\\..*$).*)",
            "destination": "/index.html"
        }
    ]
}